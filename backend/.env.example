# -----------------------------------------------------------------------------
# SOS Incident Management System - Environment Variables
# -----------------------------------------------------------------------------

# Application
PROJECT_NAME="SOS Internal Incident Management System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# Frontend / Web Application URL (Dùng tạo link CSAT & QR Code)
FRONTEND_BASE_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://sos.company.internal"]

# Hotline khẩn cấp dự phòng (khi WebRTC gọi thoại thất bại)
DEFAULT_HOTLINE="19006868"

# PostgreSQL Database (SQLAlchemy AsyncPG connection string)
DATABASE_URL="postgresql+asyncpg://sos_user:sos_secret_password@localhost:5432/sos_db"
# Fallback Synchronous URL for Alembic if needed
SYNC_DATABASE_URL="postgresql://sos_user:sos_secret_password@localhost:5432/sos_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Zalo ZNS (Zalo Notification Service) Configuration
# Khi ZALO_ZNS_MOCK_MODE=true, hệ thống chỉ log JSON payload gửi ZNS thay vì gọi ra Zalo API thật.
ZALO_ZNS_MOCK_MODE=true
ZALO_APP_ID="your_zalo_app_id"
ZALO_APP_SECRET="your_zalo_app_secret"
ZALO_OA_ID="your_zalo_oa_id"
ZALO_ACCESS_TOKEN="your_zalo_access_token"
ZALO_REFRESH_TOKEN="your_zalo_refresh_token"
ZALO_ZNS_TEMPLATE_NEW_TICKET="zns_tpl_new_ticket_alert"
ZALO_ZNS_TEMPLATE_CSAT_REQUEST="zns_tpl_csat_request"
ZALO_ZNS_TEMPLATE_ESCALATION="zns_tpl_escalation_alert"

# Emergency & Operations Escalation
ESCALATION_MANAGEMENT_PHONE="0988888888"
ESCALATION_DISPATCH_PHONE="0977777777"
SLA_HIGH_CRITICAL_MINUTES=30
SLA_STANDARD_MINUTES=120
